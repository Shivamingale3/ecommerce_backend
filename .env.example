# ============================================================
# Invoice Platform — Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
# ============================================================

# ── Spring Profile ──────────────────────────────────────────
# Options: dev | staging | prod
SPRING_PROFILES_ACTIVE=dev

# ── Database ────────────────────────────────────────────────
# Docker Compose (local dev):
#   Host:      localhost:5432
#   JDBC URL:  jdbc:postgresql://localhost:5432/invoice_db
# Compose networking (docker-on-docker):
#   Host:      postgres:5432
#   JDBC URL:  jdbc:postgresql://postgres:5432/invoice_db
POSTGRES_DB=invoice_db
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/invoice_db
SPRING_DATASOURCE_USERNAME=invoice_user
SPRING_DATASOURCE_PASSWORD=change_me_to_a_strong_password

# ── JWT / Authentication ────────────────────────────────────
# MUST be at least 256 bits (32 characters) in production.
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_you_must_set_a_256_bit_secret_minimum_in_production
# Access token TTL in milliseconds (default: 24h)
JWT_EXPIRATION_MS=86400000
# Refresh token TTL in milliseconds (default: 7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Email / SMTP ────────────────────────────────────────────
# Leave empty to disable email features (reminders, invoice delivery)
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ── Application ─────────────────────────────────────────────
SERVER_PORT=8080

# ── Reminder Scheduler ──────────────────────────────────────
# Set to false to disable the scheduled reminder job
REMINDER_ENABLED=true
